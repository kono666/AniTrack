# ============================================================
#  环境变量模板
#
#  复制为 .env 后填写. .env 已被 .gitignore 排除, 不会进仓库.
#
#  注意: Spring Boot 不会自动读 .env 文件 —— 它只认环境变量.
#  所以这个文件有两种用法:
#    1. 用 start-dev.bat 启动, 脚本会读取本文件并注入 (最省事)
#    2. 自己把这些变量设成系统环境变量, 一次配好永久生效
#  部署到服务器时, 在平台的环境变量面板里逐条填 (不要上传 .env).
#
#  变量名必须与 backend/src/main/resources/application.yml 里的 ${...} 完全一致,
#  写错了不会报错, 只会静默地用默认值 —— 这是最难查的一类问题.
# ============================================================

# ------------------------------------------------------------
#  大模型 (AI 助手)
#
#  两家协议都支持, 换个 provider 就能切, 其余代码一行不用动:
#    anthropic      -> Claude
#    openai-compat  -> DeepSeek / 通义 / Kimi / 本地 Ollama 等任何 OpenAI 兼容接口
#    mock           -> 不调用真实模型, 只回固定话术 (离线调前端 / 跑验证脚本用)
#
#  不填也能启动, 只是 AI 助手会提示「需要配置」, 其它功能不受影响.
# ------------------------------------------------------------

# DeepSeek (默认, 便宜, 中文好)
LLM_PROVIDER=openai-compat
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Claude (换成下面几行即可)
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=sk-ant-xxxxxxxx

# 本地 Ollama (完全免费, 不需要密钥)
# LLM_PROVIDER=openai-compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# 离线开发: 不调用任何真实模型
# LLM_PROVIDER=mock

# ------------------------------------------------------------
#  JWT 签名密钥
#
#  开发环境 (dev profile): 可以留空. 会使用仓库里公开的兜底值, 启动时打一条警告.
#  生产环境 (postgres profile): 必须设置.
#
#  留空的后果不是「某个功能不好用」, 而是应用直接启动失败 —— 这是刻意的:
#  这个密钥决定谁能签发登录凭证. 如果生产上悄悄用了一个公开的默认值,
#  服务会一切正常、日志毫无异常, 只是任何人都能伪造管理员 token 登录.
#  所以宁可启动失败, 也不要静默地裸奔.
#
#  生成: openssl rand -base64 48
# ------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------
#  初始管理员账号
#
#  只在「数据库里一个管理员都没有」时才会用到, 之后重启不再读取 ——
#  也就是说第一次部署配好并登录成功后, 就可以把这两个变量撤掉了.
#
#  不提供默认密码是刻意的: 一个公开的默认管理员密码等于一个后门, 而且
#  它不会以报错的形式出现, 只会以「服务一切正常, 谁都能登进来」的形式
#  存在. 所以缺凭据时宁可拒绝启动.
#
#  开发环境 (dev) 由 application.yml 提供兜底值, 这里不需要填.
# ------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=

# ------------------------------------------------------------
#  数据库
#  默认 H2 文件库, 开箱即用. 部署到服务器时换成 PostgreSQL.
# ------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://localhost:5432/anitrack
# DB_USER=anitrack
# DB_PASS=

# ------------------------------------------------------------
#  跨域访问白名单
#
#  默认留空就够了 —— 本项目按同源部署设计:
#    开发: Vite 把 /api 代理给后端, 浏览器只跟 5173 说话
#    生产: nginx 把 /api 反代给后端, 前后端同域
#  两种情况浏览器都不跨域, 后端连 CORS 过滤器都不会注册.
#
#  只有当「前端确实部署在另一个域名下」时才需要填, 逗号分隔, 例如:
#    CORS_ALLOWED_ORIGINS=https://anitrack.example.com,https://www.anitrack.example.com
#
#  两条容易踩的坑:
#    1. 只写 域名:端口, 不要带路径, 也不要带结尾的 "/"
#       (浏览器发的 Origin 头就长这样, 多写一段就永远匹配不上)
#    2. 光配后端跨域跑不通: 现在前端的 API 地址是写死的相对路径 /api,
#       必须先把前端改成可配置的绝对地址.
#
#  不要填 * —— 那等于任何网站都能从浏览器里跨域调用本 API.
# ------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------
#  登录爆破防护
#
#  连续输错 max-failures 次后锁定账号 lock-minutes 分钟; 中间成功登录一次即清零.
#  锁定期内即使密码正确也拒绝 —— 否则锁定就只是限速, 不是锁定.
#
#  为什么是「限时锁定」而不是「永久锁定」: 本项目没有找回密码、没有邮箱验证,
#  永久锁定意味着任何人只要知道你的用户名, 连试 5 次就能让你永久登不进来,
#  那是拒绝服务而不是防护.
#
#  公网部署建议比默认值更严 (例如 3 次 / 60 分钟); 本地开发想放宽也可以.
#  被锁的账号不需要等 —— 管理员可在后台「用户管理」里点「解锁」立即恢复.
# ------------------------------------------------------------
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15

# ------------------------------------------------------------
#  公网 Demo 的两道配额闸门
#
#  部署到公网时这两个值要比本地严格 —— 密钥在服务器里, 谁都可能来问.
#  本地开发把 daily 设成 0 (不限) 即可.
#
#  LLM_DAILY_BUDGET_CALLS 单位是「模型调用次数」而不是「提问次数」:
#  一次提问最多触发 6 轮工具调用, 按提问计数会把开销低估好几倍.
#  超过后 AI 助手停止服务 (其它功能照常). 默认 500, 约合 80~100 次提问.
#
#  LLM_RATE_LIMIT_PER_MINUTE 是单用户每分钟提问上限, 挡一个人狂刷.
#  ------------------------------------------------------------
# LLM_DAILY_BUDGET_CALLS=500
# LLM_RATE_LIMIT_PER_MINUTE=5
