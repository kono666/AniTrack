<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
    </parent>
    <groupId>com.animetracker</groupId>
    <artifactId>anime-tracker</artifactId>
    <version>1.0.0</version>
    <name>Anime Tracker</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- 2.9.1 的父 POM 就是 spring-boot 3.5.16, 与本项目用的 Boot 版本一一对应.
                 springdoc 与 Boot 是绑定的: 2.3.0 对应 Boot 3.2, 2.8.x 对应 3.4,
                 3.x 对应 Boot 4 —— 换 Boot 线时要连着换它. -->
            <version>2.9.1</version>
        </dependency>
        <!-- H2: 开发/测试环境 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- PostgreSQL: 生产环境 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway: 数据库迁移. 版本由 spring-boot-starter-parent 统一管理 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10 起 PostgreSQL 支持被移出了 flyway-core, 必须单独引这一份.
             实测 (解 jar 数类): flyway-core 9.22.3 内置 postgresql, 10.20.1 与 11.7.2
             都只剩 base/database/h2/sqlite —— H2 留在核心里, PostgreSQL 不在.
             少了这一份的后果很有欺骗性: H2 那条路一切正常、423 个用例全绿,
             而走真 PostgreSQL 的生产库启动时报 "Unsupported Database".
             所以它只能由 CI 的镜像那一关 (真 PG) 验出来, 本地测不出来. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Actuator: 只为了 /actuator/health 这一个探活端点 ——
             Docker HEALTHCHECK、CI 冒烟、nginx 反向代理都靠它判断「服务到底起来没有」.
             其他端点一律不暴露 (见 application.yml 的 management.endpoints.web.exposure),
             SecurityConfig 里另有一道兜底: 除 health 外的 /actuator/** 只对管理员开放. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Cache 依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- 缓存实现. 不加这一份的话 Boot 退回 ConcurrentMapCacheManager: 无界、
             永不失效, 只靠 @CacheEvict(allEntries=true) 清空 —— 而 ranking 的键是
             'rank_' + #limit, 每个不同的 limit 各占一个永不释放的条目.
             版本由 spring-boot-starter-parent 管(3.5.16 -> caffeine 3.2.4), 不写死. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- DevTools: 热重载 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 注解处理必须是显式的. 从 JDK 23 起 (JDK-8338926), javac 不再扫 classpath
                 去找注解处理器 —— 不给 -processor / -processorpath 这类显式选项, 一个处理器
                 也不跑. 本仓在此之前靠的正是那个默认行为: pom 里既没有 annotationProcessorPaths
                 也没有 proc, 全靠 javac 自己从 classpath 上认出 lombok.
                 后果很难查: 换成 JDK 23+ 编译, Lombok 整个不生效, 报出来的是满屏
                 "找不到符号" —— 而 javac 报满 -Xmaxerrs 那 100 条里**一个字都不提 Lombok**,
                 照着它排查会一头扎进业务代码, 而代码一个字没错.
                 实测: JDK 25 上 clean compile -> "Compiling 160 source files" 之后 2.5 秒
                 报满 100 条, 全部是 lombok 生成的 getter / 构造器.
                 annotationProcessorPaths 会变成 -processorpath: 既是显式请求 (新版 javac
                 认它才跑), 也不再依赖 classpath 上恰好躺着什么.
                 顺带一提, 目前 lombok 是唯一的处理器, 所以这个白名单是完整的;
                 以后再加 MapStruct 之类必须也登记到这里, 否则一样静默不生效. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
